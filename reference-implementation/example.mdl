domain checkout {
  owner: "checkout"

  entity Order @ 1 (additive) {
    @key order_id: uuid
    @pii @classification("confidential") customer_email: string
    status: string
  }
}

domain inventory {
  owner: "inventory"

  entity StockItem @ 1 (additive) {
    @key product_id: uuid
    @classification("internal") available_qty: int
  }

  projection OrderStockProjection @ 1
    from checkout.Order @ 1 as o
    join inventory.StockItem @ 1 as s on true
  {
    @classification("confidential") order_id <- o.order_id
    @classification("confidential") product_id <- s.product_id
  }
}
